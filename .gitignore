.gradle/
build/
out/
*.iws
*.iml
*.ipr
.idea/
.vscode/
.settings/
.classpath
.project
bin/

# stray compiler output (e.g. from running javac directly in a source dir)
*.class

# OS cruft
.DS_Store
Thumbs.db

docs/

# editor/tooling local config
.claude/

# local environment
.env
.env.*
!.env.example
*.log

# the key-protection secret generated by run-local.ps1. This encrypts the RSA
# private signing keys at rest, so it must never be committed - and must stay
# stable, or previously stored keys become undecryptable.
.secret.local

# key material of any kind, in case one is ever produced in the working tree
*.pem
*.key
*.p12
*.jks
*.keystore
