# Caddy automatically provisions and renews a real Let's Encrypt TLS certificate
# for AUTH_DOMAIN, then reverse-proxies to the Spring Boot service. WebAuthn/passkeys
# REQUIRE https on a real domain, so this TLS termination is what makes the passkey
# demo work at all once it is public.
#
# AUTH_DOMAIN and ACME_EMAIL are supplied as environment variables (see .env.example).
# The upstream defaults to the linked app container; override UPSTREAM if needed.
{
	email {$ACME_EMAIL}
}

# One canonical hostname: www redirects to the bare domain rather than serving
# the same pages twice.
#
# This redirect IS `permanent` (301), unlike the temporary one it replaces. That
# earlier block sent both names to the demo while the site was still being
# built, and had to stay a 302 — a 301 would have sat in visitors' browser
# caches and kept bouncing them to the demo after the site went live. A
# www-to-apex redirect has no such end date, so caching it is the point.
www.{$ROOT_DOMAIN:localhost} {
	redir https://{$ROOT_DOMAIN}{uri} permanent
}

# The personal site.
#
# ROOT_DOMAIN falls back to `localhost` deliberately: Caddy serves that with an
# internal certificate and never contacts Let's Encrypt, so a deployment that
# does not set it gets a harmless no-op instead of a cert-failure restart loop
# that would take AUTH_DOMAIN down with it.
{$ROOT_DOMAIN:localhost} {
	encode zstd gzip

	reverse_proxy {$PORTFOLIO_UPSTREAM:portfolio:3000}
}

{$AUTH_DOMAIN} {
	encode zstd gzip

	reverse_proxy {$UPSTREAM:127.0.0.1:8080} {
		# The rate limiter keys on this. X-Forwarded-For cannot be used for it:
		# Caddy APPENDS to that header, so its left-most entry is whatever the
		# caller sent, and Spring's ForwardedHeaderFilter strips the X-Forwarded-*
		# headers before the limiter runs anyway. header_up OVERWRITES, and
		# {remote_host} is the real TCP peer, so this value is not client-settable.
		header_up X-Real-IP {remote_host}

		health_uri /health
		health_interval 30s
	}
}
