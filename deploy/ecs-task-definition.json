{
  "comment_ABOUT": "ECS-on-EC2 task definition for the auth-service + Caddy (auto-HTTPS). Register with: aws ecs register-task-definition --cli-input-json file://deploy/ecs-task-definition.json. Replace ACCOUNT_ID, REGION, and the ECR image URI. Sensitive values (KEY_PROTECTION_SECRET, DB password) should be moved from 'environment' into 'secrets' backed by SSM Parameter Store — see DEPLOY-AWS.md. Sized for a single t3.micro (1 GB) free-tier instance.",
  "family": "auth-service",
  "requiresCompatibilities": ["EC2"],
  "networkMode": "bridge",
  "cpu": "1024",
  "memory": "850",
  "containerDefinitions": [
    {
      "name": "auth-service",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/auth-service:latest",
      "essential": true,
      "memory": 660,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "JAVA_TOOL_OPTIONS", "value": "-XX:MaxRAMPercentage=55 -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError" },
        { "name": "SPRING_DATASOURCE_URL", "value": "jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/authplatform" },
        { "name": "SPRING_DATASOURCE_USERNAME", "value": "authplatform" },
        { "name": "AUTH_PLATFORM_WEBAUTHN_RELYINGPARTYID", "value": "auth.yourdomain.com" },
        { "name": "AUTH_PLATFORM_WEBAUTHN_ORIGIN", "value": "https://auth.yourdomain.com" },
        { "name": "AUTH_PLATFORM_WEBAUTHN_RELYINGPARTYNAME", "value": "Kaushal Bhatt — Auth Platform" },
        { "name": "AUTH_PLATFORM_CORS_ALLOWEDORIGINS", "value": "https://yourdomain.com,https://www.yourdomain.com" },
        { "name": "AUTH_PLATFORM_RATELIMIT_ENABLED", "value": "true" },
        { "name": "AUTH_PLATFORM_RATELIMIT_MAXREQUESTS", "value": "5" },
        { "name": "AUTH_PLATFORM_RATELIMIT_WINDOWHOURS", "value": "24" }
      ],
      "secrets": [
        { "name": "AUTH_PLATFORM_ISSUER_KEY_PROTECTION_SECRET", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/auth-service/key-protection-secret" },
        { "name": "SPRING_DATASOURCE_PASSWORD", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/auth-service/db-password" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8080/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 90
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/auth-service",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "app"
        }
      }
    },
    {
      "name": "caddy",
      "image": "caddy:2-alpine",
      "essential": true,
      "memory": 128,
      "links": ["auth-service"],
      "portMappings": [
        { "containerPort": 80, "hostPort": 80, "protocol": "tcp" },
        { "containerPort": 443, "hostPort": 443, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "AUTH_DOMAIN", "value": "auth.yourdomain.com" },
        { "name": "ACME_EMAIL", "value": "you@yourdomain.com" },
        { "name": "UPSTREAM", "value": "auth-service:8080" }
      ],
      "mountPoints": [
        { "sourceVolume": "caddyfile", "containerPath": "/etc/caddy/Caddyfile", "readOnly": true },
        { "sourceVolume": "caddy-data", "containerPath": "/data" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/auth-service",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "caddy"
        }
      }
    }
  ],
  "volumes": [
    { "name": "caddyfile", "host": { "sourcePath": "/opt/auth/Caddyfile" } },
    { "name": "caddy-data", "host": { "sourcePath": "/opt/auth/caddy-data" } }
  ]
}
