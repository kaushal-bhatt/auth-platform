# =============================================================================
#  Runtime configuration for the auth-service in production.
#  Copy to `.env`, fill in the real values, and DO NOT commit the real file.
#  Every value here overrides a default in auth-service/application.yml via
#  Spring Boot's relaxed environment-variable binding. That binding is stricter than
#  it looks: EVERY dash in the property name becomes an underscore here, so
#  auth-platform.rate-limit.max-requests is AUTH_PLATFORM_RATE_LIMIT_MAX_REQUESTS.
#  A half-converted name (AUTH_PLATFORM_RATELIMIT_MAXREQUESTS) matches nothing, and
#  the property silently keeps its application.yml default instead of failing loudly.
# =============================================================================

# ---- The demo's public domain (a subdomain you control) ----------------------
# e.g. auth.kaushalbhatt.dev  — this is where the live demo & API are served.
AUTH_DOMAIN=auth.yourdomain.com
ACME_EMAIL=you@yourdomain.com

# ---- The bare domain (optional) ----------------------------------------------
# Set this if the apex domain also points at this host. Caddy then serves the
# portfolio site at `yourdomain.com` and redirects `www.` to it. Leave it unset
# if the apex points somewhere else — those blocks bind to `localhost` and do
# nothing. Both names need A records pointing here, or Caddy cannot get a cert.
#ROOT_DOMAIN=yourdomain.com

# ---- Portfolio site (only needed when ROOT_DOMAIN is set) ---------------------
# The site gets its OWN Postgres role and database inside the same container,
# not auth-platform's. It is the more exposed of the two services, and a
# separate role means a flaw there cannot reach the auth tables. Create them
# once — see DEPLOY.md, "Adding the portfolio".
#PORTFOLIO_DB=portfolio
#PORTFOLIO_DB_USER=portfolio
#PORTFOLIO_DB_PASSWORD=
#
# The site has no session secret of its own: it verifies auth-platform's tokens
# against that service's public keys and signs nothing. See the SSO block below.

# ---- SSO: letting the portfolio sign users in through this service ------------
# Switched off entirely unless a client secret is set. See SsoController.
#
# ONE variable, read by BOTH containers: auth-service verifies it, and the
# portfolio presents it when exchanging a code for tokens. It is used
# server-to-server only and must never reach a browser.
#   openssl rand -base64 32
#AUTH_PLATFORM_SSO_CLIENT_SECRET=
#
# Comma-separated, and matched by EXACT string equality — never by prefix or host.
# A prefix match on https://wekt.in/ would accept https://wekt.in/@attacker.example,
# which turns this into an open redirect handing out authorisation codes.
#AUTH_PLATFORM_SSO_REDIRECT_URIS=https://wekt.in/api/auth/callback
#
# Set this. Registration on the demo is open to anyone, so without a required role
# "authenticated" means "signed up thirty seconds ago" and the portfolio would be
# letting strangers into its admin panel while looking like it checked something.
# Grant it to your own account once — see DEPLOY.md, "Granting the admin role".
#AUTH_PLATFORM_SSO_REQUIRED_ROLE=portfolio-admin

# ---- Which build is deployed -------------------------------------------------
# NOT here. AUTH_IMAGE_TAG and PORTFOLIO_IMAGE_TAG live in a separate .env.images,
# written by deploy/remote-deploy.sh on every rollout.
#
# They are kept out of this file deliberately. auth-service loads the whole of
# .env through env_file:, so a tag written here became part of its environment —
# and compose recreates a container whose environment changed. Every portfolio
# deploy was restarting auth-service, about fifteen seconds of 502s on a service
# that had nothing to do with the rollout.
#
# Consequence: every compose command needs BOTH files, or the tags silently fall
# back to `latest`:
#   docker compose -f deploy/docker-compose.yml --env-file .env --env-file .env.images ...
#
# To roll back:  bash deploy/remote-deploy.sh <service> <older-sha>

# ---- Signing-key encryption secret (REQUIRED — app fails closed without it) --
# RSA private signing keys are AES-256-GCM encrypted at rest with this.
# Must decode to EXACTLY 32 bytes. Generate once and keep it safe & stable:
#   openssl rand -base64 32
# If you lose it, every stored signing key becomes unusable.
AUTH_PLATFORM_ISSUER_KEY_PROTECTION_SECRET=CHANGE_ME_base64_of_32_random_bytes

# ---- Database (the Postgres container in deploy/docker-compose.yml) ----------
# POSTGRES_* configure the database container; SPRING_DATASOURCE_* tell the
# service how to reach it. The user/password must match across the two sets.
# Host `postgres` is the compose service name — the database is never published
# to the host or the internet. The service runs Liquibase migrations on startup,
# so the schema is created for you on first boot.
POSTGRES_DB=authplatform
POSTGRES_USER=authplatform
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/authplatform
SPRING_DATASOURCE_USERNAME=authplatform
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_strong_db_password

# ---- WebAuthn relying party --------------------------------------------------
# RELYING_PARTY_ID must be the domain the demo page is served from (no scheme/port).
# ORIGIN must be the full https origin of that same page. Because the demo page is
# served BY this service at AUTH_DOMAIN, both align automatically — that is what
# makes passkeys work without cross-origin trouble.
AUTH_PLATFORM_WEBAUTHN_RELYING_PARTY_ID=auth.yourdomain.com
AUTH_PLATFORM_WEBAUTHN_ORIGIN=https://auth.yourdomain.com
AUTH_PLATFORM_WEBAUTHN_RELYING_PARTY_NAME=Kaushal Bhatt — Auth Platform

# ---- CORS --------------------------------------------------------------------
# The demo calls the API same-origin, so this is only needed if a separate site
# (e.g. your portfolio) ever calls this API directly from the browser. List those
# origin(s), comma-separated. Safe to leave commented out if nothing else does.
AUTH_PLATFORM_CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ---- Demo rate limit ---------------------------------------------------------
# Turn the per-IP limiter ON in production (it is OFF by default so local dev and
# tests are unaffected).
#
# MAX_REQUESTS counts REQUESTS, not visitors, and read on its own it is misleading:
# one full run of the demo costs SIX of them - /auth/register, /auth/login, and then
# an init and a complete for each of the two WebAuthn ceremonies. So set it in units
# of runs:
#
#     30 requests / 6 per run  =  5 complete demo runs per IP per 24h
#
# Setting it to 5 does NOT mean "five visitors". It means nobody finishes the demo
# even once: the last request of the passkey login is the sixth and gets a 429, so
# every visitor breaks on the final step. Keep this in sync with the endpoint list
# in RateLimitProperties#getLimitedPaths if that list ever changes.
AUTH_PLATFORM_RATE_LIMIT_ENABLED=true
AUTH_PLATFORM_RATE_LIMIT_MAX_REQUESTS=30
AUTH_PLATFORM_RATE_LIMIT_WINDOW_HOURS=24

# Note: AUTH_PLATFORM_JWT_JWKS_URI is intentionally left at its default
# (http://localhost:8080/.well-known/jwks.json) so the service verifies its own
# tokens via an internal call, without going back out through Caddy/DNS/TLS.
